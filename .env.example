# Instagram credentials (NEW account, warmed up ≥ 1 week before bot activation)
IG_USERNAME=
IG_PASSWORD=

# Instagram user ID of the owner (the only user the bot will respond to)
# To find: log in to instagram.com → visit profile → view-source → search "profile_id"
# Or use: python -c "from instagrapi import Client; c=Client(); c.login('user','pass'); print(c.user_id_from_username('owner_handle'))"
OWNER_IG_USER_ID=

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_AUX_MODEL=qwen2.5:3b

# Operational limits (per constitution §III)
TIMEZONE=Asia/Seoul
DAILY_PROACTIVE_CAP=30
DAILY_RESPONSE_CAP=50
POLL_MIN_SECONDS=30
POLL_MAX_SECONDS=90
SEND_JITTER_MIN_SECONDS=30
SEND_JITTER_MAX_SECONDS=300
IDLE_DETECTION_HOURS=4

# Paths
DATA_DIR=data
DB_PATH=data/ai_gf.db
IG_SESSION_PATH=data/ig_session.json
LOG_PATH=data/ai_gf.log
